--- Scenario A: withdraw the resolution that addresses a risk ---
--- Expected: coverage_gap_detected(risk) returns to firing.
--- closure_permitted MAY remain true: detection is automatic but
--- elevation-to-friction (which would block closure) is operator-initiated. ---
  coverage_gap_detected (before withdraw)            []
  closure_permitted (before withdraw)                [{}]
  coverage_gap_detected (after withdraw)             [{"C":"risk_2"}]
  closure_permitted (after withdraw)                 [{}]
  coverage_gap_detected reopened? PASS
  closure_permitted after withdraw: [{}] (operator-agency design — not a fix-incompleteness)

--- Scenario B: withdraw an undispositioned friction ---
--- Expected: unresolved_friction(friction) clears; closure permitted = true ---
  unresolved_friction (before withdraw)              [{"F":"friction_2"}]
  closure_permitted (before withdraw)                []
  unresolved_friction (after withdraw)               []
  closure_permitted (after withdraw)                 [{}]
  expected: unresolved_friction=[], closure_permitted=[{}] — PASS

--- Scenario C: withdraw a ratified-but-uncovered concern ---
--- Expected: unaddressed_concern(concern) clears; closure permitted = true ---
  unaddressed_concern (before withdraw)              [{"C":"concern_2"}]
  closure_permitted (before withdraw)                []
  unaddressed_concern (after withdraw)               []
  closure_permitted (after withdraw)                 [{}]
  expected: unaddressed_concern=[], closure_permitted=[{}] — PASS
